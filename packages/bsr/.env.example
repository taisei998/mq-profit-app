# ===== Amazon BSR → Googleスプレッドシート 日次バッチ =====

# ---- Googleスプレッドシート ----
# サービスアカウントのJSONキーの置き場所（このフォルダに置く想定。Gitには入りません）
GOOGLE_SERVICE_ACCOUNT_KEY_FILE="./google-service-account.json"

# 書き込み先。スプレッドシートのURLの /d/ と /edit の間の文字列がID。
# https://docs.google.com/spreadsheets/d/★ここ★/edit
SPREADSHEET_ID=
# シート（タブ）の名前
SHEET_NAME="BSR"

# ---- シートのレイアウト（既定値のままなら変更不要）----
# 1行目にASIN、2行目に見出し、3行目から日付データ。A列が日付、B列からASIN2列ずつ。
# SHEET_ASIN_ROW=1
# SHEET_LABEL_ROW=2
# SHEET_DATA_START_ROW=3
# SHEET_DATE_COLUMN=0      # 0=A列
# SHEET_FIRST_COLUMN=1     # 1=B列

# ---- Amazon SP-API ----
SPAPI_LWA_CLIENT_ID=
SPAPI_LWA_CLIENT_SECRET=
SPAPI_REFRESH_TOKEN=

# 取得するマーケットプレイス（JP / US / UK / DE）
BSR_MARKETPLACE="JP"

# 集計日の基準タイムゾーン
BSR_TIMEZONE="Asia/Tokyo"

# ===== Amazon 検索順位（SEO順位）バッチ =====
# 追跡するキーワードと書き込み先セルは rank-targets.json に書きます。
# rank-targets.example.json をコピーして作ってください。
# RANK_TARGETS_FILE="./rank-targets.json"

# 順位の数え方
#   organic … スポンサー（広告）枠を除いた自然検索の順位（既定）
#   overall … 広告を含む、画面に見えるとおりの順番
# RANK_VALUE="organic"

# 何ページ目まで探すか。1なら「1ページ目に無ければ圏外」
# RANK_MAX_PAGES=1

# 見つからなかったときにセルへ書く文字
# RANK_NOT_FOUND_TEXT="圏外"

# cell でシート名を省略したときに使うタブ名
# RANK_SHEET_NAME="SEO順位"

# 対象ドメイン（米国なら www.amazon.com）
# RANK_DOMAIN="www.amazon.co.jp"

# キーワード1件ごとに空ける間隔(ミリ秒)。短くしすぎるとAmazonに503で弾かれます
# RANK_INTERVAL_MS=6000
