# ローカル開発用（SQLite・インストール不要）
DATABASE_URL="file:./dev.db"

# 本番でPostgreSQLに切り替える例:
# DATABASE_URL="postgresql://user:password@localhost:5432/ec_ai?schema=public"
# 本番でMariaDB/MySQLに切り替える例:
# DATABASE_URL="mysql://user:password@localhost:3306/ec_ai"
# ※ provider の変更は prisma/schema.prisma の datasource 側でも必要です

PORT=4000

# フロントエンドのオリジン（カンマ区切りで複数可）。CORS許可リスト。
ALLOWED_ORIGINS="http://localhost:5173"

# 将来のOAuth2連携用（現時点では未使用・空でOK）
# OAUTH2_ISSUER_URL=
# OAUTH2_AUDIENCE=
