# サーバーの環境変数（値はすべてダミーです。実際の値はここに書かないでください）
#
# 本番では、ここに並ぶ値を**基盤が起動時に環境変数として渡します**。
# 自分でSecrets Managerを読みに行く必要はありません。
# 手元で動かすときだけ、このファイルを .env にコピーして使います。

# --- 基盤が必ず渡すもの ---
APP_URL=http://localhost:8080
PLATFORM_APP_NAME=ec-mq-profit

# --- データベース（申請して「使う」と伝えた場合に渡される） ---
DB_HOST=127.0.0.1
DB_PORT=54399
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=dummy-password
# 本番の共有DBは非TLS接続を拒否します。手元の開発用DBに繋ぐときだけ false
DB_SSL=false

# --- 社内認証システム ---
# 本番（NODE_ENV=production）では必須です。無いと起動を中止します。
# 手元の開発では未設定でも起動します（ログインだけ使えません）。開発用クライアントの値は
# DXから発行されます
ACCESS_GATEWAY_URL=
ACCESS_GATEWAY_CLIENT_ID=

# --- アプリ固有 ---
# ログインセッションの有効時間。短くすると権限変更が早く反映されます
SESSION_HOURS=8
